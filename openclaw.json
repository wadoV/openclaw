{
  "gateway": {
    "port": 8080,
    "bind": "lan",
    "mode": "local",
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "channelHealthCheckMinutes": 5
  },
  "agents": {
    "defaults": {
      "workspace": "/data/workspace",
      "model": {
        "primary": "google/gemini-2.5-pro",
        "fallbacks": [
          "deepseek/deepseek-v3"
        ]
      },
      "sandbox": {
        "mode": "off"
      }
    },
    "dev": {
      "name": "DEV Department",
      "description": "Front-end architecture and code auditing",
      "model": {
        "primary": "google/gemini-2.5-pro",
        "fallbacks": ["deepseek/deepseek-v3"]
      }
    },
    "td": {
      "name": "3D Department",
      "description": "Blender animations and scrollytelling script directions",
      "model": {
        "primary": "google/gemini-2.5-pro"
      }
    },
    "biz": {
      "name": "BIZ Department",
      "description": "Milestone tracking and luxury copywriting",
      "model": {
        "primary": "google/gemini-2.5-pro",
        "fallbacks": ["deepseek/deepseek-v3"]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "tg:8682151749"
      ]
    }
  },
  "hooks": {
    "enabled": true,
    "internal": {
      "enabled": true,
      "entries": {
        "n8n-logger": {
          "enabled": true
        }
      }
    }
  }
}
